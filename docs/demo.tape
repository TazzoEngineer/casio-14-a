# デモ動画を録画する（リポジトリ直下で: vhs docs/demo.tape）
Output docs/demo.mp4
Set Shell "zsh"
Set FontSize 15
Set Width 1080
Set Height 900
Set Padding 16
Set TypingSpeed 350ms
Set Framerate 30

Hide
Type "clear && python3 casio14a.py"
Enter
Sleep 2s
Show

Sleep 1.5s
# 掛け算: 123 × 45
Type "123*45="
Sleep 5s
# 割り算: 10 ÷ 3
Type "c"
Sleep 1s
Type "10/3="
Sleep 28s
Sleep 2s
Hide
Type "q"
